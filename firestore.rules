rules_version = '2';
// Regras do Sorteio da Pelada.
// Cada aparelho entra com login anônimo e se liga a um jogador em claims/<uid>,
// digitando um celular que está em phoneIndex. Organizadores ficam em admins/<+55...>.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function claimPath() { return /databases/$(database)/documents/claims/$(request.auth.uid); }
    function hasClaim() { return signed() && exists(claimPath()); }
    function claim() { return get(claimPath()).data; }
    function isAdmin() { return hasClaim() && exists(/databases/$(database)/documents/admins/$(claim().phone)); }
    function myPid() { return claim().pid; }
    function idxPath(phone) { return /databases/$(database)/documents/phoneIndex/$(phone); }

    // Organizadores. Todo aparelho consulta um número específico; organizadores listam,
    // adicionam e removem outros organizadores (ninguém remove a si mesmo).
    match /admins/{phone} {
      allow get: if signed();
      allow list, create: if isAdmin();
      allow delete: if isAdmin() && phone != claim().phone;
      allow update: if false;
    }

    // Celular -> jogador. Qualquer aparelho consulta um número; só organizador lista e altera.
    match /phoneIndex/{phone} {
      allow get: if signed();
      allow list, write: if isAdmin();
    }

    // Vínculo deste aparelho com um jogador.
    match /claims/{uid} {
      allow read, delete: if signed() && request.auth.uid == uid;
      allow create, update: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone', 'pid', 'at'])
        && request.resource.data.phone is string
        && (
          (request.resource.data.pid is string
            && exists(idxPath(request.resource.data.phone))
            && get(idxPath(request.resource.data.phone)).data.pid == request.resource.data.pid)
          || exists(/databases/$(database)/documents/admins/$(request.resource.data.phone))
        );
    }

    // Visitantes (qualquer aparelho conectado) veem nomes, posições e resultados.
    match /players/{pid} {
      allow read: if signed();
      allow write: if isAdmin();
    }

    // Notas que cada jogador deu (o id do documento é o jogador que avaliou).
    match /ratings/{pid} {
      allow read: if hasClaim();
      allow create, update: if hasClaim() && myPid() == pid
        && request.resource.data.keys().hasOnly(['scores', 'raterPid', 'updatedAt']);
      allow delete: if isAdmin() || (hasClaim() && myPid() == pid);
      // Organizador pode zerar as notas de alguém (resetar), sem escrever notas no lugar da pessoa.
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['scores', 'raterPid', 'updatedAt'])
        && request.resource.data.scores.size() == 0;
    }

    // Resumo público dos perfis (só médias), mantido pelos organizadores para os visitantes.
    match /public/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }

    // Resultados dos jogos: todos leem, só organizadores lançam e apagam.
    // Jogos: qualquer jogador cria ao encerrar a partida ao vivo; só organizadores alteram ou apagam.
    match /matches/{id} {
      allow read: if signed();
      allow create: if hasClaim();
      allow update, delete: if isAdmin();
    }

    // Partida ao vivo compartilhada: jogadores e organizadores começam, marcam gols e encerram.
    match /live/{id} {
      allow read, write: if hasClaim();
    }

    // Configurações do grupo (ex.: notas travadas ou em revisão).
    match /config/{id} {
      allow read: if hasClaim();
      allow write: if isAdmin();
      // o primeiro jogo do mês trava as notas, mesmo quando quem encerra é um jogador
      allow create, update: if hasClaim() && id == 'notes' && request.resource.data.locked == true;
    }

    match /draws/{id} {
      allow read: if hasClaim();
      allow write: if isAdmin();
    }
  }
}
